{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "war-of-ink",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",

  // public/ 底下的檔案直接由邊緣節點提供，_headers 也放在那裡才會生效
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // 對局房間。免費方案的 Durable Object 必須是 SQLite 版，所以用 new_sqlite_classes
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "DIR",  "class_name": "Directory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ink-scores",
      "database_id": "4da69e84-68fd-4840-a724-275287e82386"
    }
  ],

  "observability": {
    "enabled": true
  }
}
